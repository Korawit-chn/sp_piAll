[Unit]
# Steps the system clock from the backend PC once, at boot, before the sensor
# service starts. The Pi has no RTC and no internet.
Description=Set system clock from the dashboard backend
After=network-online.target
Wants=network-online.target
Before=sensor@.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
WorkingDirectory=/home/pi/sp_dashboard
ExecStart=/home/pi/venv/bin/python3 /home/pi/sp_dashboard/sync_clock.py

# The script exits 0 even when the PC is unreachable - a Pi that cannot sync
# must still boot and keep collecting.
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
