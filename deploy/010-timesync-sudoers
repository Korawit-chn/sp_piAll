# Optional. Only needed to run sync_clock.py by hand as the `pi` user -
# sensor-timesync.service already runs it as root.
#
# Install with:
#   sudo install -m 0440 -o root -g root \
#       deploy/010-timesync-sudoers /etc/sudoers.d/010-timesync
#   sudo visudo -c
#
# Scoped to the two timedatectl calls the clock step makes and nothing else.

pi ALL=(root) NOPASSWD: /usr/bin/timedatectl set-ntp false
pi ALL=(root) NOPASSWD: /usr/bin/timedatectl set-time *
